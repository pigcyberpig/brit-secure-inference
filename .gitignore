# ============================================================
# Repository content exclusions (NOT shipped to GitHub)
# ============================================================

# Paper manuscript + all writing assets (under review / private)
paper/

# External reference PDFs (third-party copyright)
papers/

# Diagnostic / historical scripts (not main entry points, per repo decision)
scripts/legacy/

# Local agent / tool configs
.agents/
.codex/
.claude/
AGENTS.md

# Unrelated scratch
writing_prompts.md

# Local eval output / scratch dirs
eval_private/
*.local

# ============================================================
# artifacts/: NOT shipped in this release.
# Results are regenerated by running the experiments (see EXPERIMENTS.md).
# To ship summary results later, replace this rule with a whitelist that
# tracks only *.md / *.csv / summary*.json / metrics.json under artifacts/.
# ============================================================
artifacts/
